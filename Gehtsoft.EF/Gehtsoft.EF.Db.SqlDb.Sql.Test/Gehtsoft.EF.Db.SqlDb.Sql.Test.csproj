    <ProjectReference Include="..\Gehtsoft.EF.Northwind\Gehtsoft.EF.Northwind.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- reuse the shared (git-ignored) connection config; copied to bin only, never committed -->
    <None Include="..\Gehtsoft.EF.Test\Configuration.json" Link="Configuration.json" Condition="Exists('..\Gehtsoft.EF.Test\Configuration.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>